<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App theme: light only, cream background -->
    <style name="Theme.Tend" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="android:windowBackground">@color/cream_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/cream_bg</item>
        <item name="android:navigationBarColor">@color/cream_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
    </style>

    <!-- Text styles -->
    <style name="Tend.Text" parent="">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Tend.Display" parent="Tend.Text">
        <item name="android:fontFamily">@font/fraunces_bold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Tend.CardTitle" parent="Tend.Text">
        <item name="android:fontFamily">@font/fraunces_bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Tend.Label" parent="Tend.Text">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Tend.Muted" parent="Tend.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Text field -->
    <style name="Tend.Input" parent="Tend.Text">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <!-- Cards -->
    <style name="Tend.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Pill buttons: filled (accent colour is applied in code) -->
    <style name="Tend.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/terracotta</item>
    </style>

    <!-- Pill buttons: cream with a thin border -->
    <style name="Tend.Button.Soft">
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/cream_bg</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Round avatar photo -->
    <style name="Tend.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
