<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Tend.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:text="Settings" />

            <!-- Profile -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tend.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/Tend.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/settingsAvatar"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_avatar"
                            android:clickable="true"
                            android:contentDescription="Profile photo"
                            android:focusable="true">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/settingsAvatarImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                app:shapeAppearanceOverlay="@style/Tend.Circle" />

                            <TextView
                                android:id="@+id/settingsAvatarInitial"
                                style="@style/Tend.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="J"
                                android:textSize="28sp" />
                        </FrameLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePhotoButton"
                            style="@style/Tend.Button.Soft"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="18dp"
                            android:fontFamily="@font/dm_sans_regular"
                            android:text="Change photo" />
                    </LinearLayout>

                    <TextView
                        style="@style/Tend.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Display name" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/nameInput"
                            style="@style/Tend.Input"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="60"
                            android:maxLines="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/saveNameButton"
                            style="@style/Tend.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:fontFamily="@font/dm_sans_medium"
                            android:text="Save" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/signedInText"
                        style="@style/Tend.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Signed in as" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tend.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/Tend.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferences" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Tend.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Week starts on"
                            android:textSize="17sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/weekMonday"
                            style="@style/Tend.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:fontFamily="@font/dm_sans_regular"
                            android:text="Monday"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/weekSunday"
                            style="@style/Tend.Button.Soft"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/dm_sans_regular"
                            android:text="Sunday"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Tend.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Colour"
                            android:textSize="17sp" />

                        <View
                            android:id="@+id/swatchTerracotta"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:contentDescription="Terracotta" />

                        <View
                            android:id="@+id/swatchGreen"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:contentDescription="Green" />

                        <View
                            android:id="@+id/swatchBlue"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:contentDescription="Blue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Tend.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily reminder"
                            android:textSize="17sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/reminderSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tend.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/Tend.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password" />

                    <TextView
                        style="@style/Tend.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Current password" />

                    <EditText
                        android:id="@+id/currentPasswordInput"
                        style="@style/Tend.Input"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <TextView
                        style="@style/Tend.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="New password" />

                    <EditText
                        android:id="@+id/newPasswordInput"
                        style="@style/Tend.Input"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/updatePasswordButton"
                        style="@style/Tend.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/dm_sans_medium"
                        android:text="Update password" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
