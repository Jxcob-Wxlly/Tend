<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="40dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo"
                app:tint="@color/terracotta" />

            <TextView
                style="@style/Tend.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tend"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            style="@style/Tend.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Create your account." />

        <TextView
            style="@style/Tend.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pick a name, email and password to get started."
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Tend.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/Tend.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display name" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/Tend.Input"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60"
                    android:maxLines="1" />

                <TextView
                    style="@style/Tend.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Email" />

                <EditText
                    android:id="@+id/emailInput"
                    style="@style/Tend.Input"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <TextView
                    style="@style/Tend.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Password" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/Tend.Input"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="newPassword"
                    android:hint="At least 6 characters"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/errorText"
                    style="@style/Tend.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerButton"
                    style="@style/Tend.Button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/dm_sans_medium"
                    android:text="Create account" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/loginLink"
            style="@style/Tend.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Already have an account? Sign in"
            android:textColor="@color/terracotta" />

    </LinearLayout>
</ScrollView>
